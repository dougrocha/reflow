#!/usr/bin/env python3
"""The checks a change needs: reads `git diff` against main and prints the smallest set of
commands that covers it, with how long each takes on this machine.

    scripts/affected                 # this branch: the merge base with main → the working tree
    scripts/affected A..B            # the change from A to B
    scripts/affected REV             # one commit, REV^1..REV (for a merge: what its PR changed)
    scripts/affected --table         # the table in CONTRIBUTING.md, generated from AREAS below
    scripts/affected --write-table   # write that table into CONTRIBUTING.md

This file is the source of truth. CONTRIBUTING.md holds the table that `--table` prints, and
tests/test_affected.py fails when they differ. The verify-parallel files come from the coverage
record in verify/parallel-conversion/README.md, read when the script runs.

A page check's `-k` names spec pages (`test_page[<spec>-`), so the harness converts only their
documents, and in quick mode only the pages they need. The specs say which pages test a feature,
not which documents a piece of converter code changes. So `-k` is the covering check only where
the change names the pages itself: a spec, a sample PDF, or a check function in
tests/pages/checks.py. For converter code the whole quick suite covers the change, and `-k` is
offered as a first run while you iterate.

The time of the quick suite depends on what the page-check harness's stage cache can reuse. Each
stage is keyed by its code's import closure (reflow.stagecache.closure), which this script reads
from the working tree.
Standard library only (reflow.stagecache, checkout), so any python3 runs it.
"""

from __future__ import annotations

import ast
import json
import re
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "scripts"))   # checkout.py
sys.path.insert(0, str(REPO / "src"))
sys.path.insert(0, str(REPO / "tests/pages"))

