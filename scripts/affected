# ---- git ----------------------------------------------------------------------------------------

def git(*args: str) -> str:
    return subprocess.run(["git", "-C", str(REPO), *args], check=True, capture_output=True,
                          text=True).stdout


@dataclass
class Change:
    """The files changed from `old` to `new`; `new` None is the working tree, untracked files too."""
    old: str
    new: str | None
    files: dict[str, str] = field(default_factory=dict)   # path → status letter (A, M, D)

    @classmethod
    def of(cls, args: list[str]) -> Change:
        if not args:
            old, new = git("merge-base", "main", "HEAD").strip(), None
        elif len(args) == 1 and ".." in args[0]:
            old, new = args[0].split("..", 1)
        elif len(args) == 1:
            old, new = f"{args[0]}^1", args[0]
        else:
            raise SystemExit("usage: scripts/affected [A..B | REV | --table | --write-table]")
        ch = cls(old, new)
        for line in git("diff", "--name-status", "--no-renames", *ch.revs()).splitlines():
            status, path = line.split("\t", 1)
            ch.files[path] = status[0]
        if new is None:
            for path in git("ls-files", "--others", "--exclude-standard").splitlines():
                ch.files[path] = "A"
        return ch

    def revs(self) -> list[str]:
        return [self.old] + ([self.new] if self.new else [])

    def read(self, path: str) -> str | None:
        """The file on the new side, or None when it is not there."""
        if self.new is None:
            p = REPO / path
            return p.read_text(encoding="utf-8") if p.is_file() else None
        try:
            return git("show", f"{self.new}:{path}")
        except subprocess.CalledProcessError:
            return None

    def listing(self, folder: str) -> list[str]:
        if self.new is None:
            return sorted(f"{folder}/{p.name}" for p in (REPO / folder).iterdir())
        return sorted(f"{folder}/{name}" for name in
                      git("ls-tree", "--name-only", f"{self.new}:{folder}").split())

    def python_files(self, folder: str) -> list[str]:
        """Every .py file under `folder`, on the new side."""
        if self.new is None:
            return sorted(str(p.relative_to(REPO)) for p in (REPO / folder).rglob("*.py"))
        names = git("ls-tree", "-r", "--name-only", self.new, "--", folder).split()
        return sorted(n for n in names if n.endswith(".py"))

    def new_lines(self, path: str) -> list[int]:
        """The changed lines on the new side. A deletion gives the line after it."""
        lines: list[int] = []
        diff = git("diff", "-U0", *self.revs(), "--", path)
        for m in re.finditer(r"^@@ -\S+ \+(\d+)(?:,(\d+))? @@", diff, re.M):
            start, count = int(m.group(1)), int(m.group(2) or 1)
            lines += range(start, start + count) if count else [max(start, 1)]
        return lines


# ---- what the change touches --------------------------------------------------------------------

def glob_re(pattern: str) -> re.Pattern:
    out = ""
    for part in re.split(r"(\*\*/|\*\*|\*)", pattern):
        out += {"**/": "(?:.*/)?", "**": ".*", "*": "[^/]*"}.get(part, re.escape(part))
    return re.compile(out + r"\Z")


def area_of(path: str) -> Area | None:
    return next((a for a in AREAS if any(glob_re(g).match(path) for g in a.globs)), None)


def coverage_files() -> list[str]:
    """The files of verify-parallel-conversion's coverage record: its `git diff --stat` line."""
    text = (REPO / COVERAGE_README).read_text(encoding="utf-8")
    m = re.search(r"git diff --stat [0-9a-f]{40} -- (.+)", text)
    if not m:
        raise SystemExit(f"scripts/affected: no coverage record in {COVERAGE_README}")
    return m.group(1).split()


def stage_closures() -> dict[str, set[str]]:
    """The files each stage of the stage cache is keyed by, from reflow.stagecache itself."""
    def files(entries: tuple[str, ...]) -> set[str]:
        return {str(p.relative_to(REPO)) for p in stagecache.closure(entries, REPO / "src")}

    return {"cold": files(stagecache.INGEST_ENTRIES) | files(stagecache.OCR_ENTRIES),
            "extract": files(stagecache.EXTRACT_ENTRIES) | files(stagecache.STAGES["pages"])}


def reading(paths: list[str]) -> str:
    stages = stage_closures()
    for regime in ("cold", "extract"):
        if any(p in stages[regime] for p in paths):
            return regime
    return "warm"


@dataclass(frozen=True)
class Spec:
    id: str
    doc: str
    kinds: frozenset[str]
    ocr: bool


def load_specs(ch: Change) -> list[Spec]:
    out = []
    for path in ch.listing(SPEC_DIR):
        if not path.endswith(".json"):
            continue
        data = json.loads(ch.read(path) or "{}")
        kinds, ocr = set(), False
        for a in data.get("assertions", []):
            kind = assertion_kind(a)
            kinds.add(kind)
            ocr |= "xfail_without_ocr" in a or (kind == "min_recall" and isinstance(a[kind], dict))
        out.append(Spec(Path(path).stem, data.get("doc", ""), frozenset(kinds), ocr))
    return out


def sample_docs(ch: Change) -> dict[str, str]:
    """Sample path → document slug, from DOCUMENTS in tests/pages/corpus.py."""
    for node in ast.parse(ch.read("tests/pages/corpus.py") or "").body:
        if (isinstance(node, (ast.Assign, ast.AnnAssign)) and isinstance(node.value, ast.Dict)
                and "DOCUMENTS" in ast.unparse(node.targets[0] if isinstance(node, ast.Assign)
                                               else node.target)):
            return {path: slug for slug, path in ast.literal_eval(node.value).items()}
    return {}


def check_kinds(ch: Change) -> set[str] | None:
    """The assertion kinds whose check functions in checks.py changed, or None when a change lies
    outside every function (an import, a constant) or in `run_check`, which runs every check."""
    src, lines = ch.read(CHECKS_PY), ch.new_lines(CHECKS_PY)
    if src is None or not lines:
        return None
    tree = ast.parse(src)
    funcs = {n.name: n for n in tree.body if isinstance(n, ast.FunctionDef)}
    calls = {name: {x.id for x in ast.walk(f) if isinstance(x, ast.Name) and x.id in funcs}
             for name, f in funcs.items()}
    registry: dict[str, str] = {}   # kind → its check function
    for node in tree.body:
        value = node.value if isinstance(node, (ast.Assign, ast.AnnAssign)) else None
        if not isinstance(value, ast.Dict):
            continue
        for k, v in zip(value.keys, value.values):
            fn = v.func if isinstance(v, ast.Call) else v   # "tables": _count("table", ...)
            if isinstance(k, ast.Constant) and isinstance(fn, ast.Name) and fn.id in funcs:
                registry[k.value] = fn.id

    def reaches(start: str, goal: str, seen: set[str]) -> bool:
        seen.add(start)
        return start == goal or any(reaches(n, goal, seen) for n in calls[start] if n not in seen)

    changed = set()
    for line in lines:
        hit = next((name for name, f in funcs.items()
                    if min([f.lineno] + [d.lineno for d in f.decorator_list]) <= line <= f.end_lineno),
                   None)
        if hit is None or hit == "run_check":
            return None
        changed.add(hit)
    kinds = set()
    for c in changed:
        reached = {kind for kind, fn in registry.items() if reaches(fn, c, set())}
        if not reached:   # used outside the checks, as corpus.py uses parse_html for every page
            return None
        kinds |= reached
    return kinds


def is_page_file(path: str, ch: Change | None = None) -> bool:
    """A test file marked `pages`, which the unit suite skips."""
    text = ch.read(path) if ch else (REPO / path).read_text(encoding="utf-8")
    return "pytestmark = pytest.mark.pages" in (text or "")


def imported_modules(source: str) -> set[str]:
    """The top-level names a module imports, wherever the import stands."""
    names: set[str] = set()
    for node in ast.walk(ast.parse(source)):
        if isinstance(node, ast.Import):
            names.update(a.name.split(".")[0] for a in node.names)
        elif isinstance(node, ast.ImportFrom) and node.module and not node.level:
            names.add(node.module.split(".")[0])
    return names


def test_files_using(ch: Change, helper: str) -> list[str]:
    """The test files that import `helper` (a tests/ module), directly or through other helpers.
    The tests put tests/ and tests/pages on the path, so a module is imported by its file name."""
    importers: dict[str, set[str]] = {}   # module name → the files importing it
    for f in ch.python_files("tests"):
        for name in imported_modules(ch.read(f) or ""):
            importers.setdefault(name, set()).add(f)
    found: set[str] = set()
    seen = {Path(helper).stem}
    todo = [Path(helper).stem]
    while todo:
        for f in importers.get(todo.pop(), ()):
            if Path(f).name.startswith("test_"):
                found.add(f)
            elif Path(f).stem not in seen:
                seen.add(Path(f).stem)
                todo.append(Path(f).stem)
    return sorted(found)


def k_filter(spec_ids: list[str], words: tuple[str, ...] = ()) -> str:
    return " or ".join([f"test_page[{s}-" for s in sorted(spec_ids)] + list(words))


# ---- the plan -----------------------------------------------------------------------------------

@dataclass
class Plan:
    checks: dict[str, set[str]] = field(default_factory=dict)       # check → the files needing it
    unit_files: dict[str, set[str]] = field(default_factory=dict)   # test file → the files
    page_files: dict[str, set[str]] = field(default_factory=dict)
    pages_k: dict[str, set[str]] = field(default_factory=dict)      # spec id → the files
    regime: str = "warm"                                            # see PAGES_SECONDS
    converter: set[str] = field(default_factory=set)
    notes: list[str] = field(default_factory=list)
    nothing: list[str] = field(default_factory=list)
    unknown: list[str] = field(default_factory=list)


# Files that ruff and mypy read (scripts/lint), whatever their row: the Python under src/ and
# tests/, and what decides the tools' settings and the packages they type-check against.
LINTED = ("pyproject.toml", "uv.lock")


def is_linted(path: str) -> bool:
    return path in LINTED or (path.endswith(".py") and path.startswith(("src/", "tests/")))


def plan(ch: Change) -> Plan:
    p = Plan()
    covered = set(coverage_files())
    specs: list[Spec] = []

    def all_specs() -> list[Spec]:
        if not specs:
            specs.extend(load_specs(ch))
        return specs

    for path, status in sorted(ch.files.items()):
        if path in covered:
            p.checks.setdefault("parallel", set()).add(path)
        if is_linted(path):
            p.checks.setdefault("lint", set()).add(path)
        area = area_of(path)
        if area is None:
            p.unknown.append(path)
            continue
        for key in area.checks:
            p.checks.setdefault(key, set()).add(path)
        present = [f for f in area.files if ch.read(f) is not None]   # there at this commit
        for f in present:
            (p.page_files if is_page_file(f, ch) else p.unit_files).setdefault(f, set()).add(path)
        if area.how == "converter":
            p.converter.add(path)
        elif area.how == "cold":
            p.regime = "cold"
        elif area.how == "spec":
            if status == "D":
                p.notes.append(f"{path} was deleted: no page left to check")
            else:
                p.pages_k.setdefault(Path(path).stem, set()).add(path)
        elif area.how == "check-fn":
            kinds = check_kinds(ch)
            if kinds is None:
                p.checks.setdefault("pages", set()).add(path)
                p.notes.append(f"{path}: the change lies outside the check functions, so it can "
                               "reach every check")
            else:
                for s in all_specs():
                    if s.kinds & kinds:
                        p.pages_k.setdefault(s.id, set()).add(path)
                p.notes.append(f"{path}: the changed functions serve the checks "
                               f"{', '.join(sorted(kinds)) or '(none)'}")
        elif area.how == "test-file":
            if status == "D":
                p.nothing.append(path)
            elif is_page_file(path, ch):
                p.page_files.setdefault(path, set()).add(path)
            else:
                p.unit_files.setdefault(path, set()).add(path)
        elif area.how == "test-helper":
            users = test_files_using(ch, path) if status != "D" else []
            if not users:
                p.checks.setdefault("unit", set()).add(path)
            for t in users:
                (p.page_files if is_page_file(t, ch) else p.unit_files).setdefault(t, set()).add(path)
        elif area.how == "sample":
            slug = sample_docs(ch).get(path)
            ids = [s.id for s in all_specs() if s.doc == slug] if slug else []
            for i in ids:
                p.pages_k.setdefault(i, set()).add(path)
            if not ids:
                p.nothing.append(path)
                if slug:
                    p.notes.append(f"{path}: no spec checks {slug}")
        elif not area.checks and not present:
            p.nothing.append(path)

    if p.converter and p.regime != "cold":
        p.regime = reading(sorted(p.converter))
    # A larger check covers a smaller one: the unit suite covers one unit file, and the quick
    # suite covers a -k selection and a page-check file.
    if "unit" in p.checks:
        for files in p.unit_files.values():
            p.checks["unit"] |= files
        p.unit_files.clear()
    if "pages" in p.checks:
        for files in [*p.pages_k.values(), *p.page_files.values()]:
            p.checks["pages"] |= files
        p.pages_k.clear()
        p.page_files.clear()
    return p


# ---- output -------------------------------------------------------------------------------------

def duration(seconds: float) -> str:
    if not seconds:
        return "not measured"
    if seconds < 1:
        return "under 1 s"
    if seconds < 60:
        return f"{seconds:.0f} s"
    m, s = divmod(round(seconds), 60)
    return f"{m} min {s} s" if s and m < 10 else f"{m + (s >= 30)} min" if m >= 10 else f"{m} min"


def shown(files: set[str]) -> str:
    fs = sorted(files)
    return ", ".join(fs[:4]) + (f" and {len(fs) - 4} more" if len(fs) > 4 else "")


def rows(ch: Change, p: Plan, py: str) -> list[tuple[float, str, str, str]]:
    """The checks to run: seconds, name, command (run from the repository root), why."""
    rows: list[tuple[float, str, str, str]] = []
    for key in CHECKS:
        if key not in p.checks:
            continue
        c, files = CHECKS[key], p.checks[key]
        seconds, why = c.seconds, shown(files)
        if key == "pages":
            seconds = PAGES_SECONDS[p.regime]
            why += (". Converter code runs on every page, and the specs can't say which documents "
                    f"it changes, so no -k filter. Time: {READING[p.regime]}")
        elif key == "parallel":
            why += ": the verify-parallel-conversion checks, or a file in their coverage record"
        if c.note:
            why += f". Note: {c.note}"
        rows.append((seconds, c.name, c.command.format(py=py), why))
    for path, files in sorted(p.unit_files.items()):
        rows.append((FILE_SECONDS.get(path, 0), "unit tests, one file",
                     UNIT_FILE.format(py=py, path=path), shown(files)))
    for path, files in sorted(p.page_files.items()):
        why = shown(files) + (f". Note: {QUICK_SKIPS[path]}" if path in QUICK_SKIPS else "")
        rows.append((FILE_SECONDS.get(path, 0), "page checks, one file",
                     PAGE_FILE.format(py=py, path=path), why))
    if p.pages_k:
        docs = {s.doc for s in load_specs(ch) if s.id in p.pages_k}
        rows.append((0, "page checks, quick, -k", PAGES_K.format(py=py, k=k_filter(list(p.pages_k))),
                     f"{len(p.pages_k)} spec page(s) of {len(docs)} document(s), named by "
                     f"{shown(set().union(*p.pages_k.values()))}. Time: by the documents, "
                     + ", ".join(f"{duration(v)} for {k}" for k, v in K_SECONDS.items())))
    return rows


def report(ch: Change, p: Plan, py: str) -> str:
    checks = rows(ch, p, py)
    side = f"{ch.old}..{ch.new}" if ch.new else f"main ({ch.old[:9]})..the working tree"
    out = [f"scripts/affected: {len(ch.files)} file(s) changed, {side}"]
    if checks:
        total = sum(r[0] for r in checks)
        out.append(f"\nRun these, about {duration(total)} in all as measured here under other "
                   "jobs' load (2 to 7); yours moves with the load:")
        for seconds, name, command, why in checks:
            out += [f"\n  {name}: {duration(seconds)}", f"    {command}", f"    why: {why}"]
    else:
        out.append("\nNo check needed.")
    if "pages" in p.checks and p.converter:
        first = [(f, sorted(p.converter & set(f.paths))) for f in FEATURES]
        first = [(f, paths) for f, paths in first if paths]
        if first:
            out.append("\nTo iterate first, run only the pages whose specs test what you changed. "
                       "This does not replace the quick suite.")
        for feat, paths in first:
            ids = [s.id for s in load_specs(ch) if s.kinds & set(feat.kinds) or (feat.ocr and s.ocr)]
            out += [f"\n  {feat.label} ({', '.join(paths)}): {len(ids)} spec page(s), "
                    f"{duration(feat.seconds)}",
                    f"    {PAGES_K.format(py=py, k=k_filter(ids, feat.files))}"]
    out += [f"\nnote: {n}" for n in p.notes]
    if p.nothing:
        out.append(f"\nNeed no check: {', '.join(p.nothing)}")
    if p.unknown:
        out.append(f"\nNo rule for: {', '.join(p.unknown)}. Read the change, pick its checks from "
                   "the table in CONTRIBUTING.md, and add a rule to scripts/affected.")
    return "\n".join(out)


def table() -> str:
    """The two tables in CONTRIBUTING.md: the checks with their commands and times, and the areas."""
    py = ".venv/bin/python"
    pages = ", ".join(f"{duration(PAGES_SECONDS[r])} {w}" for r, w in
                      (("warm", "warm"), ("extract", "re-extracting"), ("cold", "cold")))
    def times(seconds: dict[str, float]) -> str:
        return ", ".join(f"{Path(k).name} {duration(s)}" for k, s in seconds.items())

    lines = ["| Check | Command | Time | Note |", "| --- | --- | --- | --- |"]
    for key, c in CHECKS.items():
        time = pages if key == "pages" else duration(c.seconds)
        lines.append(f"| {c.name} | `{c.command.format(py=py)}` | {time} | {c.note} |")
    unit = {f: s for f, s in FILE_SECONDS.items() if not is_page_file(f)}
    page = {f: s for f, s in FILE_SECONDS.items() if is_page_file(f)}
    lines += [f"| unit tests, one file | `{UNIT_FILE.format(py=py, path='<file>')}` | {times(unit)} | |",
              f"| page checks, one file | `{PAGE_FILE.format(py=py, path='<file>')}` | {times(page)} "
              "| warm |",
              f"| page checks, -k | `{PAGES_K.format(py=py, k='test_page[<spec>-')}` | "
              f"{times(K_SECONDS)} | warm |"]

    how = {"spec": "page checks, -k: that page",
           "check-fn": "page checks, -k: the specs whose checks use the changed functions",
           "test-file": "that file",
           "test-helper": "the test files that import it, else unit tests",
           "sample": "page checks, -k: its document's specs"}
    lines += ["", "| Area | Files | Checks |", "| --- | --- | --- |"]
    for a in AREAS:
        checks = [CHECKS[k].name for k in a.checks] + [f"`{f}`" for f in a.files]
        if a.how in how:
            checks.append(how[a.how])
        files = ", ".join(f"`{g}`" for g in a.globs)
        lines.append(f"| {a.label} | {files} | {', '.join(checks) or 'none'} |")
    lines.append(f"| Python in `src/` and `tests/`, and {', '.join(f'`{f}`' for f in LINTED)} "
                 f"(in addition to its row above) | `src/**/*.py`, `tests/**/*.py`, "
                 f"{', '.join(f'`{f}`' for f in LINTED)} | {CHECKS['lint'].name} |")
    cov = ", ".join(f"`{f.removeprefix('src/reflow/')}`" for f in coverage_files())
    lines.append(f"| The coverage record of verify-parallel-conversion, in `src/reflow/` "
                 f"(in addition to its row above) | {cov} | {CHECKS['parallel'].name} |")
    return "\n".join(lines)


def write_table() -> None:
    path = REPO / "CONTRIBUTING.md"
    text = path.read_text(encoding="utf-8")
    begin, end = text.index(TABLE_BEGIN) + len(TABLE_BEGIN), text.index(TABLE_END)
    path.write_text(f"{text[:begin]}\n{table()}\n{text[end:]}", encoding="utf-8")


def main(argv: list[str]) -> int:
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__)
    elif argv[:1] == ["--table"]:
        print(table())
    elif argv[:1] == ["--write-table"]:
        write_table()
    else:
        ch = Change.of(argv)
        print(report(ch, plan(ch), str(main_checkout(REPO) / ".venv/bin/python")))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
